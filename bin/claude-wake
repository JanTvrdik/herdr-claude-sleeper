#!/usr/bin/python3 -I
"""claude-wake <session-id>: show the sleeping screen, resume claude on a keypress.

Typed into a herdr pane by claude-sleeper after it stopped an idle session.
Ctrl+C leaves the session asleep; run `claude-wake <session-id>` again later.

While the screen is up, this process holds its herdr pane as a custom agent whose
resume command is `claude-wake <session-id>`, so a herdr restart (or VM reboot)
brings the sleeping screen back instead of a plain shell. The pane is released
before claude starts; claude's own herdr integration takes over from there.
"""
import json
import os
import select
import shutil
import subprocess
import sys
import termios
import time
import tty
from datetime import datetime
from pathlib import Path

STATE_DIR = Path.home() / ".local/state/claude-sleeper"
HERDR_SOURCE = "custom:claude-sleeper"
HERDR_AGENT = "claude-sleeper"


def herdr_pane(command, *args):
    """Best effort `herdr pane <command> <this pane> ...`; never breaks the wake screen."""
    pane = os.environ.get("HERDR_PANE_ID")
    herdr = shutil.which("herdr") or os.environ.get("HERDR_BIN_PATH")
    if os.environ.get("HERDR_ENV") != "1" or not pane or not herdr:
        return
    try:
        subprocess.run(
            [herdr, "pane", command, pane, "--source", HERDR_SOURCE, "--agent", HERDR_AGENT,
             "--seq", str(time.time_ns()), *args],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def ago(ts):
    h = (time.time() - ts) / 3600
    return f"{h:.0f}h ago" if h < 48 else f"{h / 24:.0f}d ago"


def read_key():
    """Read one keypress; True to resume, False on Ctrl+C / Ctrl+D."""
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = os.read(fd, 1)
        # Swallow the rest of multi-byte keys (arrows etc.) so they don't reach claude.
        while select.select([fd], [], [], 0.05)[0]:
            os.read(fd, 64)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    return ch not in (b"\x03", b"\x04", b"")


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip())
    sid = sys.argv[1]
    state_file = STATE_DIR / f"{sid}.json"
    try:
        st = json.loads(state_file.read_text())
    except (OSError, ValueError):
        sys.exit(f"claude-wake: no sleeping session {sid}; try: claude --resume {sid}")

    title = st.get("title") or st.get("name") or sid
    sys.stdout.write(f"\033]0;💤 {title}\007")   # terminal / herdr tab title
    sys.stdout.write("\033[H\033[2J")             # clear screen, keep scrollback
    print(f"\n  💤  Claude is sleeping\n")
    print(f"      {title}")
    print(f"      {st['cwd']}\n")
    print(f"      last active   {datetime.fromtimestamp(st['idle_since']):%a %d %b %H:%M}  ({ago(st['idle_since'])})")
    print(f"      asleep since  {datetime.fromtimestamp(st['slept_at']):%a %d %b %H:%M}")
    print(f"      session       {sid}\n")
    print("      Press any key to resume · Ctrl+C to leave it asleep\n", flush=True)

    # Hold the pane so a herdr restart runs `claude-wake <sid>` here again.
    herdr_pane("report-agent", "--state", "idle", "--message", f"💤 sleeping: {title}",
               "--", "claude-wake", sid)
    try:
        resume = read_key()
    except KeyboardInterrupt:
        resume = False
    herdr_pane("release-agent")
    if not resume:
        print(f"  Still asleep. Resume later with: claude-wake {sid}")
        sys.exit(130)

    try:
        os.chdir(st["cwd"])
    except OSError as e:
        sys.exit(f"claude-wake: cannot cd to {st['cwd']}: {e}")
    argv = ["claude", "--resume", sid, *st.get("resume_args", [])]
    print(f"  Resuming: {' '.join(argv)}\n", flush=True)
    state_file.unlink(missing_ok=True)
    os.execvp("claude", argv)


if __name__ == "__main__":
    main()
