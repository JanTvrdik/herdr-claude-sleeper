#!/usr/bin/python3 -I
"""claude-wake <session-id>: show the sleeping screen, resume claude on a keypress.

Typed into a herdr pane by claude-sleeper after it stopped an idle session.
Ctrl+C leaves the session asleep; run `claude-wake <session-id>` again later.

While the screen is up, this process holds its herdr pane as a custom agent whose
resume command is `claude-wake <session-id>`, so a herdr restart (or a reboot)
brings the sleeping screen back instead of a plain shell. The pane is released
before claude starts; claude's own herdr integration takes over from there.
"""
import json
import os
import re
import select
import shutil
import subprocess
import sys
import termios
import time
import tty
from datetime import datetime
from pathlib import Path

STATE_DIR = Path.home() / ".local/state/claude-sleeper"
HERDR_SOURCE = "custom:claude-sleeper"
HERDR_AGENT = "claude-sleeper"
SESSION_ID = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")


# While waiting for a key, re-send the herdr registration at these offsets (seconds), then
# every REREGISTER_EVERY. Re-sending is idempotent; it repairs a registration that failed
# (herdr still holding the stopped claude) or was cleared afterwards.
REGISTER_SCHEDULE = (3, 10, 30, 60)
REREGISTER_EVERY = 300


def herdr_pane(command, *args):
    """Best effort `herdr pane <command> <this pane> ...`; True on success, never raises."""
    pane = os.environ.get("HERDR_PANE_ID")
    herdr = shutil.which("herdr") or os.environ.get("HERDR_BIN_PATH")
    if os.environ.get("HERDR_ENV") != "1" or not pane or not herdr:
        return False
    try:
        return subprocess.run(
            [herdr, "pane", command, pane, "--source", HERDR_SOURCE, "--agent", HERDR_AGENT,
             "--seq", str(time.time_ns()), *args],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def register(sid, title):
    """Hold the pane so a herdr restart runs `claude-wake <sid>` here again.

    Two steps: herdr accepts a resume command only from a source that already holds the
    pane, and a combined report is rejected when the state part has not been applied yet.
    """
    message = f"💤 sleeping: {title}"
    herdr_pane("report-agent", "--state", "idle", "--message", message)
    return herdr_pane("report-agent", "--state", "idle", "--message", message, "--", "claude-wake", sid)


def ago(ts):
    h = (time.time() - ts) / 3600
    return f"{h:.0f}h ago" if h < 48 else f"{h / 24:.0f}d ago"


def read_key(on_idle):
    """Read one keypress; True to resume, False on Ctrl+C / Ctrl+D.

    on_idle() runs on the REGISTER_SCHEDULE while no key has been pressed.
    """
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    start = time.monotonic()
    offsets = list(REGISTER_SCHEDULE)
    try:
        tty.setraw(fd)
        while True:
            if not offsets:
                offsets.append(time.monotonic() - start + REREGISTER_EVERY)
            if select.select([fd], [], [], max(0.0, start + offsets[0] - time.monotonic()))[0]:
                break
            offsets.pop(0)
            on_idle()
        ch = os.read(fd, 1)
        # Swallow the rest of multi-byte keys (arrows etc.) so they don't reach claude.
        while select.select([fd], [], [], 0.05)[0]:
            os.read(fd, 64)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    return ch not in (b"\x03", b"\x04", b"")


def set_title(text):
    """Set the terminal / herdr tab title. Control characters would end the escape sequence early."""
    text = re.sub(r"[\x00-\x1f\x7f]", "", text)
    sys.stdout.write(f"\033]0;{text}\007")


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip())
    sid = sys.argv[1]
    if not SESSION_ID.fullmatch(sid):
        sys.exit(f"claude-wake: not a Claude Code session id: {sid}")
    state_file = STATE_DIR / f"{sid}.json"
    try:
        st = json.loads(state_file.read_text())
    except (OSError, ValueError):
        sys.exit(f"claude-wake: no sleeping session {sid}; try: claude --resume {sid}")

    title = st.get("title") or st.get("name") or sid
    set_title(f"💤 {title}")
    sys.stdout.write("\033[H\033[2J")  # clear screen, keep scrollback
    print(f"\n  💤  Claude is sleeping\n")
    print(f"      {title}")
    print(f"      {st['cwd']}\n")
    print(f"      last active   {datetime.fromtimestamp(st['idle_since']):%a %d %b %H:%M}  ({ago(st['idle_since'])})")
    print(f"      asleep since  {datetime.fromtimestamp(st['slept_at']):%a %d %b %H:%M}")
    print(f"      session       {sid}\n")
    print("      Press any key to resume · Ctrl+C to leave it asleep\n", flush=True)

    register(sid, title)
    try:
        resume = read_key(lambda: register(sid, title))
    except KeyboardInterrupt:
        resume = False
    herdr_pane("release-agent")
    # Put back the title from before the sleep (empty clears it): claude does not set one,
    # so the 💤 would otherwise stay on the resumed session's tab.
    set_title(st.get("title") or "")
    if not resume:
        print(f"  Still asleep. Resume later with: claude-wake {sid}")
        sys.exit(130)

    try:
        os.chdir(st["cwd"])
    except OSError as e:
        sys.exit(f"claude-wake: cannot cd to {st['cwd']}: {e}")
    argv = ["claude", "--resume", sid, *st.get("resume_args", [])]
    print(f"  Resuming: {' '.join(argv)}\n", flush=True)
    state_file.unlink(missing_ok=True)
    os.execvp("claude", argv)


if __name__ == "__main__":
    main()
